  catalog_product ||--o{ inventory_inventory : stock_logical
  catalog_sale ||--o{ inventory_inventory : allocation_logical
  identity_customer ||--o{ inventory_inventory_reservation : buyer_logical
  inventory_inventory_reservation ||--o{ payment_payment : intent_logical
  inventory_inventory_reservation ||--o{ orders_customer_order : order_logical
