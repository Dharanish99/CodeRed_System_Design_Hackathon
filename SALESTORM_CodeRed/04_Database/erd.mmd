erDiagram
  identity_customer {
    uuid customer_id PK
  }
  catalog_category {
    uuid category_id PK
  }
  catalog_product {
    uuid product_id PK
    uuid category_id
  }
  catalog_sale {
    uuid sale_id PK
    text status
  }
  catalog_deal {
    uuid deal_id PK
    uuid sale_id
    uuid product_id
  }
  catalog_coupon {
    uuid coupon_id PK
    uuid sale_id
    timestamptz expires_at
  }
  cart_cart {
    uuid cart_id PK
    uuid customer_id
  }
  cart_cart_item {
    uuid cart_item_id PK
    uuid cart_id
    uuid product_id
  }
  inventory_inventory {
    uuid inventory_id PK
    uuid sale_id
    uuid product_id
    integer available_quantity
    integer reserved_quantity
    integer sold_quantity
  }
  inventory_inventory_reservation {
    uuid reservation_id PK
    uuid inventory_id
    uuid sale_id
    uuid customer_id
    text status
    timestamptz expires_at
    uuid checkout_id
    uuid payment_id
  }
  payment_payment {
    uuid payment_id PK
    uuid reservation_id
    uuid checkout_id
    uuid customer_id
    text status
  }
  orders_customer_order {
    uuid order_id PK
    uuid reservation_id
    uuid customer_id
    uuid payment_id
    text status
  }
  orders_order_item {
    uuid order_item_id PK
    uuid order_id
    uuid product_id
  }
  fulfilment_shipment {
    uuid shipment_id PK
    uuid order_id
    text status
  }
  notification_notification {
    uuid notification_id PK
    uuid event_id
    uuid order_id
    text status
  }
  catalog_category ||--o{ catalog_product : classifies
  catalog_sale ||--o{ catalog_deal : offers
  catalog_product ||--o{ catalog_deal : prices
  catalog_sale ||--o{ catalog_coupon : promotes
